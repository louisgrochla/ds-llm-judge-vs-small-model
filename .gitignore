# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
.python-version

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Environment
.env
.env.local
.env.*.local

# Data — keep raw downloads out, but commit the processed parquets
# (they're small + stable, lets Colab clone-and-go without rerunning notebook 01)
data/raw/
data/*.csv
data/*.parquet
data/*.json
!data/README.md
!data/sample/
# Block contents of data/processed/ by default, then re-include the parquets + label names.
# Use the *single-star* form so the directory itself isn't ignored — negation can't reach
# inside an ignored directory.
data/processed/*
!data/processed/*.parquet
!data/processed/*.txt

# Model artefacts
checkpoints/
*.pt
*.pth
*.bin
*.safetensors
runs/
wandb/

# Results — keep figures (small), drop large model outputs
results/predictions/
results/eval_outputs/
results/*.parquet
!results/figures/
!results/.gitkeep

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp

# Build
build/
dist/
*.egg-info/

# Personal content-marketing notes — kept locally, not for the public repo
docs/post-bank.md

# Local research notes — contains unverified agent output, do not publish
research-notes/
HANDOVER*.md

# Dry-run request previews from the eval harness (regenerate with --dry-run)
results/llm_runs/*/dry_run.json

# Frozen-encoder probability arrays: ~130MB, and regenerated in ~2 min by
# scripts/run_frozen_encoder.py. The metrics they produce are committed.
results/frozen_encoder/**/*.npy
